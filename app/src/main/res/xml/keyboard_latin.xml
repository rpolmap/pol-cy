        <Key android:codes="-200" android:keyLabel="dz" android:keyOutputText="dz"/>
        <Key android:codes="-200" android:keyLabel="dź" android:keyOutputText="dź"/>
        <Key android:codes="-200" android:keyLabel="dż" android:keyOutputText="dż"/>
        <Key android:codes="-200" android:keyLabel="ch" android:keyOutputText="ch"/>
        <Key android:codes="63" android:keyLabel="?"/>
        <Key android:codes="33" android:keyLabel="!"/>
    </Row>

    <!-- Row 2: Polish diacritics -->
    <Row>
        <Key android:codes="261" android:keyLabel="ą"/>
        <Key android:codes="281" android:keyLabel="ę"/>
        <Key android:codes="263" android:keyLabel="ć"/>
