<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="9.6%p"
    android:keyHeight="50dp"
    android:horizontalGap="0.4%p"
    android:verticalGap="4dp">

    <!-- Row 1: Polish digraphs -->
    <Row>
        <Key android:codes="-200" android:keyLabel="sz" android:keyOutputText="sz"/>
        <Key android:codes="-200" android:keyLabel="cz" android:keyOutputText="cz"/>
        <Key android:codes="-200" android:keyLabel="rz" android:keyOutputText="rz"/>
