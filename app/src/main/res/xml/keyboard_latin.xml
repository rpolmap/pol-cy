        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="13.6%p" android:isRepeatable="true" android:keyBackground="@drawable/bg_key_special"/>
    </Row>

    <!-- Bottom Action Row -->
    <Row>
        <Key android:codes="-101" android:keyLabel="PL ➔ КИР" android:keyWidth="17.6%p" android:keyBackground="@drawable/bg_key_special"/>
        <Key android:codes="44" android:keyLabel="," android:keyWidth="11.6%p"/>
